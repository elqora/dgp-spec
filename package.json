{
  "name": "@elqora/dgp-spec",
  "version": "1.4.0",
  "description": "Canonical plain contracts and generated interoperability artifacts for the Digital Goods Protocol.",
  "license": "GPL-3.0-only",
  "type": "module",
  "types": "./dist/index.d.ts",
  "module": "./dist/index.js",
  "sideEffects": false,
  "packageManager": "npm@11.6.4",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/elqora/dgp-spec.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist",
    "schemas",
    "fixtures",
    "docs",
    "CONTRACTS.md",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./schemas/*": "./schemas/*",
    "./fixtures/*": "./fixtures/*",
    "./package.json": "./package.json"
  },
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "build": "npm run clean && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run",
    "generate": "npm run typecheck && node scripts/generate-schemas.mjs",
    "check:schemas": "node scripts/check-schemas.mjs",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "check": "npm run lint && npm run typecheck && npm run test && npm run check:boundaries && npm run check:schemas && npm run build",
    "prepack": "npm run check"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "^24.10.0",
    "ajv": "^8.17.1",
    "ajv-formats": "3.0.1",
    "eslint": "10.0.1",
    "globals": "^16.5.0",
    "ts-json-schema-generator": "2.9.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.65.0",
    "vitest": "4.1.10"
  }
}
