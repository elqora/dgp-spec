{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://schemas.elqora.com/dgp/v1/service-capability.schema.json",
  "$ref": "#/definitions/ServiceCapability",
  "definitions": {
    "ServiceCapability": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "enabled": {
          "type": "boolean"
        },
        "description": {
          "type": [
            "string",
            "null"
          ]
        },
        "meta": {
          "type": "object"
        }
      },
      "required": [
        "id",
        "enabled",
        "description",
        "meta"
      ],
      "additionalProperties": false,
      "description": "A named behavior exposed by a handler service."
    }
  }
}
