{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://schemas.elqora.com/dgp/v1/product-definition-validation-conformance-suite.schema.json",
  "$ref": "#/definitions/ProductDefinitionValidationConformanceSuite",
  "definitions": {
    "ProductDefinitionValidationConformanceSuite": {
      "type": "object",
      "properties": {
        "version": {
          "type": "string",
          "const": "1"
        },
        "cases": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/ProductDefinitionValidationConformanceCase"
          }
        }
      },
      "required": [
        "version",
        "cases"
      ],
      "additionalProperties": false,
      "description": "Versioned collection consumed by Validation and applicable SDK bindings."
    },
    "ProductDefinitionValidationConformanceCase": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "definition": {
          "$ref": "#/definitions/ProductDefinition"
        },
        "context": {
          "$ref": "#/definitions/ProductDefinitionValidationConformanceContext"
        },
        "expected": {
          "$ref": "#/definitions/ProductDefinitionValidationConformanceExpectation"
        }
      },
      "required": [
        "id",
        "description",
        "definition",
        "context",
        "expected"
      ],
      "additionalProperties": false,
      "description": "One language-independent semantic publication-validation case."
    },
    "ProductDefinition": {
      "type": "object",
      "properties": {
        "id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "$ref": "#/definitions/Integer"
            }
          ]
        },
        "name": {
          "type": "string"
        },
        "filters": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/ProductFilter"
          }
        },
        "fields": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/ProductField"
          }
        },
        "order_for_tags": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "includes_for_buttons": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "excludes_for_buttons": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "option_effects_for_buttons": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": {
              "$ref": "#/definitions/OptionEffectForButton"
            }
          }
        },
        "value_effects_for_triggers": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": {
              "$ref": "#/definitions/FieldValueEffect"
            }
          }
        },
        "schema_version": {
          "$ref": "#/definitions/ProductDefinitionSchemaVersion"
        },
        "fallbacks": {
          "anyOf": [
            {
              "$ref": "#/definitions/ServiceFallbacks"
            },
            {
              "type": "null"
            }
          ]
        },
        "description": {
          "type": [
            "string",
            "null"
          ]
        },
        "notices": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/ProductNotice"
          }
        },
        "meta": {
          "type": "object"
        }
      },
      "required": [
        "id",
        "name",
        "filters",
        "fields",
        "order_for_tags",
        "includes_for_buttons",
        "excludes_for_buttons",
        "option_effects_for_buttons",
        "value_effects_for_triggers",
        "schema_version",
        "fallbacks",
        "description",
        "notices",
        "meta"
      ],
      "additionalProperties": false,
      "description": "Canonical authored root contract for a DGP v1 product."
    },
    "Integer": {
      "type": "integer",
      "description": "A JSON integer represented by TypeScript's number type."
    },
    "ProductFilter": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "bind_id": {
          "type": "string"
        },
        "service_id": {
          "$ref": "#/definitions/ServiceId"
        },
        "includes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "excludes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "capabilities": {
          "$ref": "#/definitions/CapabilityRequirements"
        },
        "quantity_default": {
          "type": "number"
        },
        "meta": {
          "type": "object"
        }
      },
      "required": [
        "id",
        "label"
      ],
      "additionalProperties": false
    },
    "ServiceId": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "$ref": "#/definitions/Integer"
        }
      ],
      "description": "Stable handler-assigned service identity."
    },
    "CapabilityRequirements": {
      "type": "object",
      "additionalProperties": {
        "type": "boolean"
      }
    },
    "ProductField": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "button": {
              "type": "boolean",
              "const": false
            },
            "id": {
              "type": "string"
            },
            "type": {
              "type": "string"
            },
            "variant": {
              "type": "string",
              "description": "Optional host-registry variant; registries fall back to their default variant."
            },
            "label": {
              "type": "string"
            },
            "bind_id": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              ]
            },
            "name": {
              "type": "string"
            },
            "required": {
              "type": "boolean"
            },
            "multiple": {
              "type": "boolean",
              "description": "Allows more than one selected option for this field."
            },
            "default_value": {
              "$ref": "#/definitions/JsonValue"
            },
            "defaults": {
              "type": "object",
              "additionalProperties": {
                "$ref": "#/definitions/JsonValue"
              }
            },
            "options": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/FieldOption"
              }
            },
            "description": {
              "type": "string"
            },
            "pricing_role": {
              "$ref": "#/definitions/PricingRole"
            },
            "validation": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/FieldValidationRule"
              }
            },
            "quantity_default": {
              "type": "number"
            },
            "quantity": {
              "$ref": "#/definitions/QuantityRule"
            },
            "utility": {
              "$ref": "#/definitions/UtilityDefinition"
            },
            "meta": {
              "type": "object"
            }
          },
          "required": [
            "id",
            "label",
            "type"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "button": {
              "type": "boolean",
              "const": true
            },
            "service_id": {
              "$ref": "#/definitions/ServiceId"
            },
            "id": {
              "type": "string"
            },
            "type": {
              "type": "string"
            },
            "variant": {
              "type": "string",
              "description": "Optional host-registry variant; registries fall back to their default variant."
            },
            "label": {
              "type": "string"
            },
            "bind_id": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              ]
            },
            "name": {
              "type": "string"
            },
            "required": {
              "type": "boolean"
            },
            "multiple": {
              "type": "boolean",
              "description": "Allows more than one selected option for this field."
            },
            "default_value": {
              "$ref": "#/definitions/JsonValue"
            },
            "defaults": {
              "type": "object",
              "additionalProperties": {
                "$ref": "#/definitions/JsonValue"
              }
            },
            "options": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/FieldOption"
              }
            },
            "description": {
              "type": "string"
            },
            "pricing_role": {
              "$ref": "#/definitions/PricingRole"
            },
            "validation": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/FieldValidationRule"
              }
            },
            "quantity_default": {
              "type": "number"
            },
            "quantity": {
              "$ref": "#/definitions/QuantityRule"
            },
            "utility": {
              "$ref": "#/definitions/UtilityDefinition"
            },
            "meta": {
              "type": "object"
            }
          },
          "required": [
            "button",
            "id",
            "label",
            "type"
          ]
        }
      ]
    },
    "JsonValue": {
      "anyOf": [
        {
          "$ref": "#/definitions/JsonPrimitive"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/definitions/JsonValue"
          }
        },
        {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/definitions/JsonValue"
          }
        }
      ]
    },
    "JsonPrimitive": {
      "type": [
        "string",
        "number",
        "boolean",
        "null"
      ]
    },
    "FieldOption": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "value": {
          "$ref": "#/definitions/JsonPrimitive"
        },
        "service_id": {
          "$ref": "#/definitions/ServiceId"
        },
        "pricing_role": {
          "$ref": "#/definitions/PricingRole"
        },
        "quantity_default": {
          "type": "number"
        },
        "utility": {
          "$ref": "#/definitions/UtilityDefinition"
        },
        "meta": {
          "type": "object"
        },
        "children": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/FieldOption"
          }
        }
      },
      "required": [
        "id",
        "label"
      ],
      "additionalProperties": false
    },
    "PricingRole": {
      "type": "string",
      "enum": [
        "base",
        "utility"
      ]
    },
    "UtilityDefinition": {
      "type": "object",
      "properties": {
        "rate": {
          "type": "number"
        },
        "mode": {
          "$ref": "#/definitions/UtilityMode"
        },
        "value_by": {
          "type": "string",
          "enum": [
            "value",
            "length"
          ]
        },
        "percent_base": {
          "type": "string",
          "enum": [
            "service_total",
            "base_service",
            "all"
          ]
        },
        "label": {
          "type": "string"
        }
      },
      "required": [
        "rate",
        "mode"
      ],
      "additionalProperties": false
    },
    "UtilityMode": {
      "type": "string",
      "enum": [
        "flat",
        "per_quantity",
        "per_value",
        "percent"
      ]
    },
    "FieldValidationRule": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "value_by": {
              "type": "string",
              "enum": [
                "value",
                "length"
              ]
            },
            "op": {
              "$ref": "#/definitions/FieldValidationOperator"
            },
            "value": {
              "$ref": "#/definitions/JsonValue"
            },
            "min": {
              "type": "number"
            },
            "max": {
              "type": "number"
            },
            "values": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/JsonValue"
              }
            },
            "pattern": {
              "type": "string"
            },
            "pattern_flags": {
              "type": "string"
            },
            "code": {
              "type": "string"
            },
            "message": {
              "type": "string"
            }
          },
          "required": [
            "op"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "value_by": {
              "type": "string",
              "const": "eval"
            },
            "expression": {
              "$ref": "#/definitions/BrowserJavaScriptExpression"
            },
            "op": {
              "$ref": "#/definitions/FieldValidationOperator"
            },
            "value": {
              "$ref": "#/definitions/JsonValue"
            },
            "min": {
              "type": "number"
            },
            "max": {
              "type": "number"
            },
            "values": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/JsonValue"
              }
            },
            "pattern": {
              "type": "string"
            },
            "pattern_flags": {
              "type": "string"
            },
            "code": {
              "type": "string"
            },
            "message": {
              "type": "string"
            }
          },
          "required": [
            "expression",
            "op",
            "value_by"
          ]
        }
      ]
    },
    "FieldValidationOperator": {
      "type": "string",
      "enum": [
        "eq",
        "neq",
        "gt",
        "gte",
        "lt",
        "lte",
        "between",
        "in",
        "nin",
        "truthy",
        "falsy",
        "match"
      ]
    },
    "BrowserJavaScriptExpression": {
      "type": "object",
      "properties": {
        "language": {
          "type": "string",
          "const": "javascript"
        },
        "body": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "language",
        "body"
      ],
      "additionalProperties": false,
      "description": "A trusted host-authored browser JavaScript function body."
    },
    "QuantityRule": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "value_by": {
              "type": "string",
              "enum": [
                "value",
                "length"
              ]
            },
            "multiply": {
              "type": "number"
            },
            "clamp": {
              "$ref": "#/definitions/QuantityClamp"
            },
            "fallback": {
              "type": "number"
            }
          },
          "required": [
            "value_by"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "value_by": {
              "type": "string",
              "const": "eval"
            },
            "expression": {
              "$ref": "#/definitions/BrowserJavaScriptExpression"
            },
            "multiply": {
              "type": "number"
            },
            "clamp": {
              "$ref": "#/definitions/QuantityClamp"
            },
            "fallback": {
              "type": "number"
            }
          },
          "required": [
            "expression",
            "value_by"
          ]
        }
      ]
    },
    "QuantityClamp": {
      "type": "object",
      "properties": {
        "min": {
          "type": "number"
        },
        "max": {
          "type": "number"
        }
      },
      "additionalProperties": false
    },
    "OptionEffectForButton": {
      "type": "object",
      "properties": {
        "force_visible": {
          "type": "boolean"
        },
        "include": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "exclude": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "FieldValueEffect": {
      "type": "object",
      "properties": {
        "value": {
          "$ref": "#/definitions/JsonValue"
        },
        "mode": {
          "type": "string",
          "enum": [
            "always",
            "if_empty"
          ]
        },
        "clear_on_deactivate": {
          "type": "boolean"
        }
      },
      "required": [
        "value"
      ],
      "additionalProperties": false
    },
    "ProductDefinitionSchemaVersion": {
      "type": "string",
      "const": "1"
    },
    "ServiceFallbacks": {
      "type": "object",
      "properties": {
        "nodes": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": {
              "$ref": "#/definitions/ServiceId"
            }
          }
        },
        "global": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": {
              "$ref": "#/definitions/ServiceId"
            }
          }
        }
      },
      "additionalProperties": false
    },
    "ProductNotice": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "type": {
          "$ref": "#/definitions/ProductNoticeType"
        },
        "kind": {
          "$ref": "#/definitions/ProductNoticeKind"
        },
        "severity": {
          "$ref": "#/definitions/ProductNoticeSeverity"
        },
        "target": {
          "$ref": "#/definitions/ProductNoticeTarget"
        },
        "title": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "reason": {
          "type": "string"
        },
        "marked_at": {
          "type": "string",
          "format": "date-time"
        },
        "meta": {
          "type": "object"
        }
      },
      "required": [
        "id",
        "type",
        "kind",
        "severity",
        "target",
        "title"
      ],
      "additionalProperties": false
    },
    "ProductNoticeType": {
      "type": "string",
      "enum": [
        "public",
        "private"
      ]
    },
    "ProductNoticeKind": {
      "type": "string",
      "enum": [
        "label",
        "warning",
        "deprecation",
        "compat",
        "migration",
        "policy"
      ]
    },
    "ProductNoticeSeverity": {
      "type": "string",
      "enum": [
        "info",
        "warning",
        "error"
      ]
    },
    "ProductNoticeTarget": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "scope": {
              "type": "string",
              "const": "global"
            }
          },
          "required": [
            "scope"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "scope": {
              "type": "string",
              "const": "node"
            },
            "node_kind": {
              "type": "string",
              "enum": [
                "tag",
                "field",
                "option"
              ]
            },
            "node_id": {
              "type": "string"
            }
          },
          "required": [
            "scope",
            "node_kind",
            "node_id"
          ],
          "additionalProperties": false
        }
      ]
    },
    "ProductDefinitionValidationConformanceContext": {
      "type": "object",
      "properties": {
        "services": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/HandlerService"
          }
        },
        "field_registry": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/FieldRegistryConformanceEntry"
          }
        },
        "rate_policy": {
          "anyOf": [
            {
              "$ref": "#/definitions/ServiceRatePolicy"
            },
            {
              "type": "null"
            }
          ]
        },
        "fallback_policy": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "require_capability_fit": {
                  "type": "boolean"
                },
                "rate_policy": {
                  "$ref": "#/definitions/ServiceRatePolicy"
                }
              },
              "required": [
                "require_capability_fit",
                "rate_policy"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "services",
        "field_registry",
        "rate_policy",
        "fallback_policy"
      ],
      "additionalProperties": false,
      "description": "Portable optional inputs required by catalog- and registry-aware rules."
    },
    "HandlerService": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/definitions/ServiceId"
        },
        "name": {
          "type": "string"
        },
        "description": {
          "type": [
            "string",
            "null"
          ]
        },
        "category": {
          "type": [
            "string",
            "null"
          ]
        },
        "rate": {
          "type": [
            "number",
            "null"
          ]
        },
        "min": {
          "$ref": "#/definitions/Integer"
        },
        "max": {
          "$ref": "#/definitions/Integer"
        },
        "capabilities": {
          "$ref": "#/definitions/ServiceCapabilities"
        },
        "meta": {
          "type": "object"
        },
        "state": {
          "$ref": "#/definitions/HandlerServiceState"
        },
        "state_reason": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "id",
        "name",
        "description",
        "category",
        "rate",
        "min",
        "max",
        "capabilities",
        "meta",
        "state",
        "state_reason"
      ],
      "additionalProperties": false,
      "description": "Portable service-catalog representation reconciled from the backend SDK.\n\nRates are handler-provided catalog data. They are not final prices or charges, and browser consumers must not treat them as authoritative checkout totals."
    },
    "ServiceCapabilities": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/definitions/ServiceCapability"
      },
      "description": "Capabilities keyed by the same stable identifier carried by each value."
    },
    "ServiceCapability": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "enabled": {
          "type": "boolean"
        },
        "description": {
          "type": [
            "string",
            "null"
          ]
        },
        "meta": {
          "type": "object"
        }
      },
      "required": [
        "id",
        "enabled",
        "description",
        "meta"
      ],
      "additionalProperties": false,
      "description": "A named behavior exposed by a handler service."
    },
    "HandlerServiceState": {
      "type": "string",
      "enum": [
        "enabled",
        "disabled",
        "locked"
      ]
    },
    "FieldRegistryConformanceEntry": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string"
        },
        "variants": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "multiple": {
          "type": "boolean"
        }
      },
      "required": [
        "type",
        "variants",
        "multiple"
      ],
      "additionalProperties": false,
      "description": "Host field-registry capability supplied to publication validation."
    },
    "ServiceRatePolicy": {
